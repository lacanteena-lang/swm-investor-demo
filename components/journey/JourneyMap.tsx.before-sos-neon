                {journeyDuration}
              </p>
            </div>

            {/* DISTANCE */}
            <div className="flex min-w-0 flex-col items-center justify-center border-l border-white/10 px-1.5 py-3">
              <p className="text-[7px] font-semibold uppercase tracking-[0.02em] text-cyan-300">
                DISTANCE
              </p>
