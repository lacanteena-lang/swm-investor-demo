import { NextRequest, NextResponse } from "next/server";

export async function POST(request: NextRequest) {
  try {
    const body = await request.json();

    const {
      incidentId,
      contactCount,
      status,
    } = body;

    if (!incidentId) {
      return NextResponse.json(
        { error: "Incident ID is required." },
        { status: 400 }
      );
    }

    if (typeof contactCount !== "number") {
      return NextResponse.json(
        { error: "Contact count is required." },
        { status: 400 }
      );
    }

    if (!status) {
      return NextResponse.json(
        { error: "Notification status is required." },
        { status: 400 }
      );
    }

    const apiKey = process.env.SMSHORIZON_API_KEY;
    const username = process.env.SMSHORIZON_USER;
    const senderId = process.env.SMSHORIZON_SENDER_ID;
    const templateId = process.env.SMSHORIZON_TID;
    const testNumber = process.env.SMSHORIZON_TEST_NUMBER;

    if (!apiKey || !username || !senderId || !templateId || !testNumber) {
      return NextResponse.json(
        { error: "SmsHorizon configuration is incomplete." },
        { status: 500 }
      );
    }

    const message = "OTP for your new user account registration is: 123456`n`n- SmsHorizon";

    const smsBody = new URLSearchParams({
      user: username,
      mobile: testNumber,
      senderid: senderId,
      message,
      tid: templateId,
      type: "txt",
    });

    const smsResponse = await fetch(
      "https://smshorizon.com/api/v2/sendsms",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${apiKey}`,
          Accept: "application/json",
          "Content-Type": "application/x-www-form-urlencoded",
        },
        body: smsBody.toString(),
        cache: "no-store",
      }
    );

    const smsResult = await smsResponse.json();

    if (!smsResponse.ok) {
      console.error("SmsHorizon send failed:", smsResult);

      return NextResponse.json(
        {
          success: false,
          incidentId,
          contactCount,
          status,
          error: smsResult,
        },
        { status: smsResponse.status }
      );
    }

    console.log(
      `SmsHorizon SMS sent for incident ${incidentId}:`,
      smsResult
    );

    return NextResponse.json({
      success: true,
      incidentId,
      contactCount,
      status,
      sms: smsResult,
    });
  } catch (error) {
    console.error("Notification API error:", error);

    return NextResponse.json(
      { error: "Unable to send notification." },
      { status: 500 }
    );
  }
}


